# Copy this file to .env and fill it in. .env is gitignored - never commit it.

# ── Telegram ─────────────────────────────────────────────────────────────
# The only secret this bot needs. Get it from @BotFather on Telegram:
#   1. Open Telegram, search for @BotFather, press Start
#   2. Send /newbot
#   3. Give it a display name, then a username ending in "bot"
#   4. It replies with a token - paste it below
# Shape: digits, a colon, then a long random string.
TELEGRAM_BOT_TOKEN=123456789:AAF-replace-this-with-your-real-token

# Seconds Telegram holds the connection open when there is no news. This is
# not a delay: a message arriving at second 3 comes back at second 3.
POLL_TIMEOUT=25

# On startup, ignore anything sent while the bot was switched off. Set to
# false if you want it to work through the backlog instead.
SKIP_BACKLOG=true

# How many photos may be analysed at the same time.
WORKERS=2

# ── Internal model API (serve/app.py) ────────────────────────────────────
PREDICT_URL=http://127.0.0.1:5000/predict
HEALTH_URL=http://127.0.0.1:5000/health
PREDICT_TIMEOUT=120

# ── Conversation pacing ──────────────────────────────────────────────────
# Seconds between the three result messages.
MESSAGE_GAP_SECONDS=10

# Shown in the "no confident call" message. Keep it matching the model's own
# threshold, which serve/app.py reports at /health.
LOW_CONFIDENCE_HINT=0.90

# ── Image handling ───────────────────────────────────────────────────────
MIN_SHORT_EDGE=224
MAX_LONG_EDGE=1600

# ── Logging ──────────────────────────────────────────────────────────────
BOT_DEBUG=false
