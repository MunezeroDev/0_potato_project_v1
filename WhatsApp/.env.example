# Copy this file to .env and fill it in. .env is gitignored - never commit it.

# ── Twilio (console.twilio.com -> Account Info) ──────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The sandbox sender is the same for every Twilio account. Leave as is unless
# you have moved to an approved WhatsApp business number.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── ngrok ────────────────────────────────────────────────────────────────
# THIS CHANGES EVERY TIME YOU RESTART NGROK on the free tier.
# Paste the exact URL you put in the Twilio console, including /whatsapp.
PUBLIC_WEBHOOK_URL=https://xxxxxxxx.ngrok-free.app/whatsapp

# Set to false only for local curl testing. Leave true for anything public.
TWILIO_VALIDATE_SIGNATURE=true

# ── Internal model API (serve/app.py) ────────────────────────────────────
PREDICT_URL=http://127.0.0.1:5000/predict
HEALTH_URL=http://127.0.0.1:5000/health
PREDICT_TIMEOUT=120

# ── Conversation pacing ──────────────────────────────────────────────────
# Seconds between the three result messages.
MESSAGE_GAP_SECONDS=10

# ── This server ──────────────────────────────────────────────────────────
BOT_HOST=0.0.0.0
BOT_PORT=5005
BOT_DEBUG=false
